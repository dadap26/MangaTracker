{
  "manifest_version": 3,
  "name": "Manga Tracker Badge",
  "version": "1.0.0",
  "description": "Shows your ongoing manga count on the toolbar, with a red badge when there are new chapters.",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["https://script.google.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
